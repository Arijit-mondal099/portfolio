# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Match the project's Prettier config (2-space, LF, final newline) so the two
# don't disagree — Prettier reads .editorconfig, and mismatches break format:check.
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
